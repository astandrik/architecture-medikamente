  <diagram id="ishikawa-migration-bottlenecks" name="Ishikawa migration bottlenecks">
    <mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Диаграмма Исикавы: узкие места при миграции «Медикаменте»" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1760" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Эффект: снижение производительности, управляемости и надёжности новой архитектуры после переноса legacy-ограничений" style="text;html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#666666;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="1760" height="35" as="geometry"/>
        </mxCell>


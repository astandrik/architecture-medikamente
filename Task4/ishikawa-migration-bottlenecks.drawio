          <mxGeometry x="760" y="565" width="10" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="anchor_arch" value="" style="ellipse;html=1;fillColor=none;strokeColor=none;opacity=0;" vertex="1" parent="1">
          <mxGeometry x="950" y="565" width="10" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="anchor_process" value="" style="ellipse;html=1;fillColor=none;strokeColor=none;opacity=0;" vertex="1" parent="1">
          <mxGeometry x="1130" y="565" width="10" height="10" as="geometry"/>
        </mxCell>

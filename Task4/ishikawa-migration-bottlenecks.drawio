        </mxCell>

        <mxCell id="effect" value="Снижение производительности&lt;br&gt;и управляемости&lt;br&gt;новой архитектуры&lt;br&gt;после миграции" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1580" y="505" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="spine" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=5;strokeColor=#666666;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="spine_start" target="effect">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="infra" value="&lt;b&gt;Инфраструктура&lt;/b&gt;&lt;br&gt;&#8226; один локальный Windows Server для AD, файлов, Exchange и сети&lt;br&gt;&#8226; файловый режим 1С и общий диск плохо масштабируются&lt;br&gt;&#8226; не заданы RTO/RPO, резервирование и DR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="145" width="360" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="data" value="&lt;b&gt;Данные и хранилища&lt;/b&gt;&lt;br&gt;&#8226; Excel, JPG/PDF и сканы без владельцев, версий и статусов&lt;br&gt;&#8226; нет золотого источника для пациента, записи, договора, платежа и анализа&lt;br&gt;&#8226; нет Data Lineage и метаданных преобразований" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="115" width="390" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="integration" value="&lt;b&gt;Интеграции&lt;/b&gt;&lt;br&gt;&#8226; почта, общий диск и Excel используются как интеграционный механизм&lt;br&gt;&#8226; ККМ связана с 1С через TCP/IP и OLE без API-изоляции&lt;br&gt;&#8226; API лаборатории пока без SLA, retry, timeout и безопасных повторов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="915" y="145" width="395" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="observability" value="&lt;b&gt;Наблюдаемость, безопасность, соответствие&lt;/b&gt;&lt;br&gt;&#8226; нет централизованного аудита действий и потоков&lt;br&gt;&#8226; нет метрик latency, error rate, sync lag, DORA, MTTR, RTO/RPO&lt;br&gt;&#8226; доступ не связан с категорией данных и целью обработки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;verticalAlign=top;spacing=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1320" y="180" width="420" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="architecture" value="&lt;b&gt;ПО и архитектура&lt;/b&gt;&lt;br&gt;&#8226; домены пациента, записи, медкарты, платежей и аналитики не разделены&lt;br&gt;&#8226; нет фасада над legacy-хранилищами для Branch by Abstraction&lt;br&gt;&#8226; нет контрактных, регрессионных и нагрузочных тестов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=left;verticalAlign=top;spacing=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="245" y="835" width="420" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="processes" value="&lt;b&gt;Процессы&lt;/b&gt;&lt;br&gt;&#8226; ручной ввод и дублирование между Excel, сканами и 1С&lt;br&gt;&#8226; не описаны cutover, rollback, go/no-go и сверка старой/новой систем&lt;br&gt;&#8226; качество данных и бизнес-метрики не контролируются регулярно" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=left;verticalAlign=top;spacing=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="695" y="875" width="430" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="people" value="&lt;b&gt;Персонал и организация&lt;/b&gt;&lt;br&gt;&#8226; 3 IT-специалиста отвечают за всё от поддержки до Kubernetes&lt;br&gt;&#8226; знания о ручных процессах находятся у отдельных сотрудников&lt;br&gt;&#8226; нет кросс-функциональной команды миграции по доменам" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=12;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1155" y="815" width="405" height="165" as="geometry"/>
        </mxCell>

